rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- role helpers ---------- */
    function adminRef() {
      return /databases/$(database)/documents/admin_accounts/$(request.auth.uid);
    }
    /* true unless the committee explicitly turned the module off */
    function visitorsOn() {
      return !exists(/databases/$(database)/documents/settings/taman_config)
        || get(/databases/$(database)/documents/settings/taman_config).data.get('visitorsEnabled', true) != false;
    }

    function isAdmin() {
      return request.auth != null && exists(adminRef());
    }
    function role() {
      return isAdmin() ? get(adminRef()).data.role : '';
    }
    // Only these two roles may confirm money as received.
    function isVerifier() {
      return isAdmin() && (get(adminRef()).data.role == 'treasurer'
                        || get(adminRef()).data.role == 'super_admin');
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------- resident identity ----------
       A resident's session is a Firebase custom token minted by the login service with
       two claims: their house number and their road. Rules compare documents to those
       claims rather than looking the resident up, which costs ZERO extra reads — a
       get() inside the rule would bill one extra read per document evaluated, i.e. 24
       extra reads for a 24-bill page, on every page load, forever.

       Consequence to remember: if an admin corrects a house's road or number, that
       resident's claim is stale until they next log in. */
    function isResident() {
      return request.auth != null && request.auth.token.get('unit', '') != '';
    }
    function residentUnit() {
      return request.auth.token.get('unit', '');
    }
    function residentRoad() {
      return request.auth.token.get('road', '');
    }
    function ownsHouse(data) {
      return isResident()
        && data.get('unitNumber', '') == residentUnit()
        && data.get('road', '') == residentRoad();
    }

    /* ---------- residents ---------- */
    match /residents/{docId} {
      // LOCKDOWN 2026-10-27: this was `if true` so the browser could compare the PIN.
      // That made every PIN, name and phone number world-readable.
      // Now: a resident sees their own house; the rest of the roster is committee-only.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == docId);
      // Residents hold NO write access to their own document. The login service stamps
      // isJoined/lastLoginAt with server credentials, so that badge now counts every
      // login instead of only the ones that arrived via a magic link.
      allow write: if isAdmin();
    }

    /* ---------- invoices: the money trail ---------- */
    match /invoices/{docId} {
      // A resident may read bills addressed to their own house, and nothing else.
      allow read: if isAdmin() || ownsHouse(resource.data);
      allow create, delete: if isAdmin();

      // 1. Any committee member may RECORD a payment. It stays provisional —
      //    it does not count as collected and the resident does not see PAID.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'provisional'
        && request.resource.data.recordedBy == request.auth.uid
        && onlyChanged(['status', 'recordedBy', 'recordedAt', 'receiptNumber',
                        'paymentMethod', 'paymentReference']);

      // 2. Only a treasurer or super_admin may VERIFY. A note is mandatory so the
      //    confirmation is anchored to a bank line, not to a click.
      //    Verifier must differ from recorder — except super_admin, who is recorded
      //    as a self-verification so the exception is visible in the audit view.
      allow update: if isVerifier()
        && resource.data.status == 'provisional'
        && request.resource.data.status == 'paid'
        && request.resource.data.verification == 'verified'
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifyNote is string
        && request.resource.data.verifyNote.size() >= 3
        && request.resource.data.selfVerified == (request.auth.uid == resource.data.recordedBy)
        && (request.auth.uid != resource.data.recordedBy || role() == 'super_admin')
        && onlyChanged(['status', 'verification', 'verifiedBy', 'verifiedAt',
                        'verifyNote', 'selfVerified', 'receiptNumber']);

      // 3. Voiding is super_admin only, reason required, and the only exit from
      //    a verified row. Nothing can quietly un-verify a payment.
      allow update: if role() == 'super_admin'
        && request.resource.data.status == 'void'
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() >= 3
        && request.resource.data.voidedBy == request.auth.uid
        && onlyChanged(['status', 'voidReason', 'voidedBy', 'voidedAt']);
    }

    /* ---------- append-only audit trail ---------- */
    match /payment_events/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at is timestamp;
      allow update, delete: if false;            // never rewritten, never erased
    }

    /* ---------- committee accounts ---------- */
    match /admin_accounts/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && role() == 'super_admin';
    }

    /* ---------- resident-facing, read-mostly ---------- */
    match /settings/taman_config { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stats_monthly/{docId} { allow read: if true; allow write: if isAdmin(); }

    match /visits/{docId} {
      // Guest passes carry visitor names and vehicle plates, so they are scoped to the
      // house that issued them.
      allow read: if isAdmin() || ownsHouse(resource.data);
      /* the committee can switch the visitor module off; that must stop NEW passes
         at the database, not just hide the button. Existing passes stay cancellable
         so a switch-off never strands someone who already issued one.
         A resident may only create a pass for their own house. */
      allow create: if visitorsOn()
        && ((isResident() && ownsHouse(request.resource.data)) || isAdmin());
      // Residents may cancel their own pass (status + updatedAt only), nothing else.
      allow update: if isAdmin()
        || (ownsHouse(resource.data) && onlyChanged(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /community_chat/{id} {
      // Estate-wide chat: any signed-in resident may read and post, but a post must
      // carry the poster's own house — you cannot speak as another household.
      allow read: if isAdmin() || isResident();
      allow create: if isAdmin()
        || (isResident()
            && request.resource.data.get('unit', '') == residentUnit()
            && request.resource.data.get('road', '') == residentRoad());
      allow delete: if isAdmin();
    }

    /* ---------- everything else: committee read only ----------
       This used to allow write, which silently overrode every scoped rule above —
       Firestore ORs all matching rules, so one blanket `allow write: if isAdmin()`
       let any committee member do anything anywhere, including verify payments.
       Writes must stay on explicitly matched paths. */
    match /{document=**} {
      allow read: if isAdmin();
    }
  }
}
